# Backend app configuration
JWT_SECRET=replace-me

# Admin credentials (required for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Database bootstrap configuration used by scripts/setup_database.sh
DB_HOST=postgres
POSTGRES_HOST_PORT=5433
DB_NAME=distdb_dev
DB_USER=app_distbackend_dev
DB_PASSWORD=password
DB_SSLMODE=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_RECREATE=false
DB_GRANT_SUPERUSER=false

# Runtime behavior
UPLOAD_PATH=/app/uploads
INTERNAL_SOCKET_PATH=/var/run/faelp/dist-backend.sock
INTERNAL_SOCKET_ENABLED=true
ORG_BACKEND_SOCKET_PATH=/var/run/faelp/org-backend.sock
DISTRIBUTION_CENTER_ID=

# Frontend serving paths inside the dist-backend container
FRONTEND_DISTRIBUTION_ENABLED=true
FRONTEND_DISTRIBUTION_PORT=8081
FRONTEND_DISTRIBUTION_PATH=/app/frontend/distribution/dist
FRONTEND_ADMIN_ENABLED=true
FRONTEND_ADMIN_PATH=/app/frontend/distadmin/dist
FRONTEND_ADMIN_PORT=8083
