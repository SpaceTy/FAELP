# Backend app configuration
DATABASE_URL=postgresql://app_orgbackend_dev:password@postgres:5432/orgdb_dev?sslmode=disable
WORKOS_API_KEY=replace-me
WORKOS_CLIENT_ID=replace-me
JWT_SECRET=replace-me

# Database bootstrap configuration used by scripts/setup_database.sh
DB_HOST=postgres
DB_PORT=5432
DB_NAME=orgdb_dev
DB_USER=app_orgbackend_dev
DB_PASSWORD=password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_RECREATE=false
DB_GRANT_SUPERUSER=false

# Runtime behavior
INTERNAL_SOCKET_ENABLED=true

# Frontend serving paths inside the org-backend container
FRONTEND_USER_ENABLED=true
FRONTEND_USER_PATH=/app/frontend/user/dist
FRONTEND_ADMIN_ENABLED=true
FRONTEND_ADMIN_PATH=/app/frontend/orgadmin/dist
FRONTEND_ADMIN_PORT=8082
